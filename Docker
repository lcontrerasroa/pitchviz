FROM python:3.9-slim

# Install system dependencies for aeneas and its build
RUN apt-get update && apt-get install -y \
    ffmpeg \
    espeak \
    libespeak-ng1 \
    libsndfile1 \
    libxml2-dev \
    libffi-dev \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set workdir
WORKDIR /app

# Copy app files
COPY . /app
# Install Python dependencies (numpy first)
RUN pip install --no-cache-dir numpy && \
    pip install --no-cache-dir -r requirements.txt

# Install aeneas separately (after numpy is in place)
RUN pip install --no-cache-dir aeneas


# Expose port for Render
EXPOSE 10000

# Run the app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10000"]
